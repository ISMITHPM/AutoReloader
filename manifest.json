{
  "manifest_version": 3,
  "name": "Auto Reloader",
  "version": "1.2.0",
  "description": "Reload tabs automatically at a user-defined interval, manually or by URL rule.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Auto Reloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
