{
  "name": "autoreloader",
  "version": "1.2.0",
  "description": "AutoReloader is a Chrome extension that automatically reloads browser tabs at user-defined intervals.",
  "private": true,
  "scripts": {
    "format": "prettier --write \"*.js\" \"*.css\" \"*.html\"",
    "format:check": "prettier --check \"*.js\" \"*.css\" \"*.html\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
